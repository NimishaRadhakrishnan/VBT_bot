# Copy to .env and fill in. Everything except DATABASE_URL and TELEGRAM_BOT_TOKEN is optional.
DATABASE_URL=postgresql://agri:agri@localhost:5432/agri
API_BASE_URL=http://localhost:8000
API_KEY=change-me-to-a-long-random-string

# Telegram (create the bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
# AGRONOMIST_CHAT_ID: add the bot to the agronomists' group, send a message, then read the id from
# https://api.telegram.org/bot<TOKEN>/getUpdates  (group ids start with -100...)
AGRONOMIST_CHAT_ID=

# LLM: gemini | anthropic | none   (none = rules + templates only, still works)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Speech (Tamil voice notes): sarvam | none
STT_PROVIDER=sarvam
SARVAM_API_KEY=
TTS_ENABLED=false

# Vision: bioclip (needs requirements-ml.txt, downloads ~1.7 GB once) | vlm | none
CROP_BACKEND=bioclip
BLUR_THRESHOLD=60

# Retrieval: bge-m3 (needs requirements-ml.txt) | hash (dev only)
EMBEDDING_PROVIDER=bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
